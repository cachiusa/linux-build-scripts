# configs for veux
USE_CCACHE=1
ARCH=arm64
LLVM=1
LLVM_IAS=1
DEFCONFIG=veux_defconfig
M_TARGETS=(
    Image
    dtbs
)
POST_DEFCONFIG_CMDS="
    configure_lto thin;
    configure -e KSU;
    configure_droidspaces_gki;
"
configure_inject_ramdisk() {
    configure \
        -e RD_LZMA \
        -e INITRAMFS_FORCE \
        -e INITRAMFS_FORCE_RECOVERY \
    --set-str INITRAMFS_SOURCE "source/usr/ramdisk.cpio" \
        -e INITRAMFS_COMPRESSION_LZMA
}